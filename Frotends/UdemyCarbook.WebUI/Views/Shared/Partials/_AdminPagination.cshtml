@model IPagedList

@{
    var request = ViewBag.CurrentRequest as BaseFilterRequest;
    var actionName = ViewContext.RouteData.Values["action"]?.ToString();
}

@if (Model != null && Model.PageCount > 1)
{
    <div class="d-flex justify-content-center mt-2">
        @Html.PagedListPager(Model, page => Url.Action(actionName,
        new
        {
            page = page,
            search = request?.Search
        }),
        new PagedListRenderOptions
        {
            LiElementClasses = new string[] { "page-item" },
            PageClasses = new string[] { "page-link" },
            DisplayLinkToFirstPage = X.PagedList.Mvc.Core.PagedListDisplayMode.Never,
            DisplayLinkToLastPage = X.PagedList.Mvc.Core.PagedListDisplayMode.Never,
            DisplayLinkToPreviousPage = X.PagedList.Mvc.Core.PagedListDisplayMode.Always,
            DisplayLinkToNextPage = X.PagedList.Mvc.Core.PagedListDisplayMode.Always,
            MaximumPageNumbersToDisplay = 5,
            UlElementClasses = new string[] { "pagination justify-content-center" }
        }
        )
</div>
}
