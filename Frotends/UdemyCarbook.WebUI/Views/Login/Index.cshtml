@model ResultLoginDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Carbook | Giriş Yap</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/admin/vertical/assets/css/auth.css" />

</head>
<body>

    <div class="auth-container">
        <div class="auth-card">
            <a href="/Default/Index/" class="brand-logo">
                <i class="fas fa-car-side"></i> CARBOOK
            </a>

            <h2 class="h4 text-center mb-1">Tekrar Hoş Geldin!</h2>
            <p class="text-center text-light opacity-75 mb-4">Admin paneline erişmek için giriş yapın.</p>

            <form method="post">
                <div class="mb-3">
                    <label class="form-label small">Kullanıcı Adı</label>
                    <input type="text" class="form-control" asp-for="UserName" placeholder="Kullanıcı adınız" required>
                </div>

                <div class="mb-3">
                    <label class="form-label small">Şifre</label>
                    <input type="password" class="form-control" asp-for="Password" placeholder="••••••••" required>
                </div>

                <div class="mb-3">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="remember">
                        <label class="form-check-label small" for="remember">Beni Hatırla</label>
                    </div>
                </div>

                <button type="submit" class="btn btn-auth">Giriş Yap</button>
            </form>

            <div class="social-icons">
                <a href="#"><i class="fab fa-facebook-f"></i></a>
                <a href="#"><i class="fab fa-google"></i></a>
                <a href="#"><i class="fab fa-github"></i></a>
            </div>

            <div class="text-center mt-4">
                <p class="mb-0 small">
                    Hesabınız yok mu?
                    <a href="/Register/CreateAppUser/" class="text-warning fw-bold text-decoration-none"> Kayıt Ol</a>
                </p>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>