@model CreateRegisterDto
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Carbook | Kayıt Ol</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/admin/vertical/assets/css/auth.css" />
</head>
<body>

    <div class="auth-container">
        <div class="auth-card">
            <a href="/Default/Index/" class="brand-logo">
                <i class="fas fa-car-side"></i> CARBOOK
            </a>

            <h2 class="h4 text-center mb-1">Yeni Hesap Oluştur</h2>
            <p class="text-center text-light opacity-75 mb-4">Hızlıca kayıt olup araç kiralamaya başla!</p>

            <form method="post">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label small">Adınız</label>
                        <input type="text" class="form-control" asp-for="Name" placeholder="Ad" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label small">Soyadınız</label>
                        <input type="text" class="form-control" asp-for="Surname" placeholder="Soyad" required>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small">E-posta Adresi</label>
                    <input type="email" class="form-control" asp-for="Email" placeholder="ornek@mail.com" required>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label small">Kullanıcı Adı</label>
                        <input type="text" class="form-control" asp-for="UserName" placeholder="carbook01" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label small">Şifre</label>
                        <input type="password" class="form-control" asp-for="Password" placeholder="••••••••" required>
                    </div>
                </div>

                <button type="submit" class="btn btn-auth mt-3">Hesabı Oluştur</button>
            </form>

            <div class="text-center mt-4">
                <p class="mb-0 opacity-75">
                    Zaten bir hesabınız var mı?
                    <a href="/Login/Index" class="text-warning text-decoration-none fw-bold"> Giriş Yap</a>
                </p>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>