@model IPagedList<ResultPendingDto>

@{
    ViewData["Title"] = "Bekleyen Rezervasyonlar";
    var request = ViewBag.CurrentRequest as BaseFilterRequest;
    int count = (Model.PageNumber - 1) * Model.PageSize;
}

<div class="page-content-custom">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
        <div class="mb-2 mb-md-0">
            <h4 style="font-weight:700; margin:0; color:#1b2559;">Bekleyen Rezervasyonlar</h4>
            <p style="color:#a3aed0; font-size:0.9rem; margin:0;">
                Henüz onaylanmamış araç kiralama taleplerini buradan onaylayabilir veya reddedebilirsiniz.
            </p>
        </div>

        <div class="d-flex align-items-center">
            <partial name="Partials/_AdminSearch" model="request"></partial>
        </div>
    </div>

    <div class="table-card">
        <div class="table-responsive">
            <table class="table table-modern">
                <thead>
                    <tr>
                        <th style="width:60px;">#</th>
                        <th>MÜŞTERİ</th>
                        <th>ARAÇ</th>
                        <th style="width:170px;">BAŞLANGIÇ</th>
                        <th style="width:170px;">BİTİŞ</th>
                        <th style="width:110px;">DURUM</th>
                        <th class="text-right" style="width:220px;">İŞLEMLER</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        count++;
                        <tr>
                            <td>@count</td>
                            <td>@item.Name @item.Surname</td>
                            <td>@item.CarName</td>
                            <td>@item.PickUpDateTime.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@item.DropOffDateTime.ToString("dd.MM.yyyy HH:mm")</td>

                            <td>
                                <span class="badge bg-warning text-dark">@item.Status</span>
                            </td>

                            <td class="text-right">
                                <div class="d-inline-flex gap-2">
                                    <form method="post" asp-area="Admin" asp-controller="AdminReservation" asp-action="Approve">
                                        <input type="hidden" name="id" value="@item.ReservationId" />
                                        <button type="submit" class="btn btn-success btn-sm rounded-pill px-3">
                                            Onayla
                                        </button>
                                    </form>

                                    <form method="post" asp-area="Admin" asp-controller="AdminReservation" asp-action="Reject">
                                        <input type="hidden" name="id" value="@item.ReservationId" />
                                        <button type="submit" class="btn btn-danger btn-sm rounded-pill px-3">
                                            Reddet
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="Partials/_AdminPagination" model="Model"></partial>
    </div>

</div>