@model List<ResultLocationDto>

@{
    ViewData["Title"] = "Lokasyon Listesi";
    int count = 0;
}

<div class="page-content-custom">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
        <div class="mb-2 mb-md-0">
            <h4 style="font-weight: 700; margin:0; color:#1b2559;">Lokasyon Listesi</h4>
            <p style="color: #a3aed0; font-size: 0.9rem; margin:0;">
                Ana sayfa ve araç kiralama sayfasında kullanılan alınış / bırakılış lokasyonlarını yönetin.
            </p>
        </div>

        <div class="d-flex align-items-center">
            <a asp-area="Admin"
               asp-controller="AdminLocation"
               asp-action="CreateLocation"
               class="btn btn-primary btn-sm rounded-pill px-4 py-2"
               style="background: #4318FF; border:none; font-weight:500;">
                <i class="fas fa-plus mr-1"></i> Yeni Ekle
            </a>
        </div>
    </div>

    <div class="table-card">
        <div class="table-responsive table-scroll">
            <table class="table table-modern">
                <thead>
                    <tr>
                        <th style="width: 50px;">#</th>
                        <th>LOKASYON</th>
                        <th style="width: 120px;" class="text-right">İŞLEMLER</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        count++;

                        string initials = "";
                        if (!string.IsNullOrWhiteSpace(item.Name))
                        {
                            var parts = item.Name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
                            if (parts.Length > 0) initials += parts[0][0];
                            if (parts.Length > 1) initials += parts[^1][0];
                            initials = initials.ToUpper();
                        }

                        string colorClass = "bg-blue-light";
                        if (count % 3 == 0) { colorClass = "bg-green-light"; }
                        else if (count % 3 == 2) { colorClass = "bg-orange-light"; }

                        <tr>
                            <td class="font-weight-bold text-muted">@count</td>

                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="avatar-sm @colorClass">@initials</div>
                                    <span class="font-weight-bold">@item.Name</span>
                                </div>
                            </td>

                            <td class="text-right">
                                <a asp-area="Admin"
                                   asp-controller="AdminLocation"
                                   asp-action="UpdateLocation"
                                   asp-route-id="@item.LocationId"
                                   class="btn-icon-sm"
                                   title="Güncelle">
                                    <i class="fas fa-pen fa-xs"></i>
                                </a>

                                <a asp-area="Admin"
                                   asp-controller="AdminLocation"
                                   asp-action="RemoveLocation"
                                   asp-route-id="@item.LocationId"
                                   class="btn-icon-sm js-delete"
                                   title="Sil"
                                   data-title="Lokasyonu Sil"
                                   data-message="Bu Lokasyonu silmek istediğinize emin misiniz?">
                                    <i class="fas fa-trash fa-xs"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
