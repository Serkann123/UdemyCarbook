@model IPagedList<ResultCommentDto>

@{
    ViewData["Title"] = "Yorum Listesi";
    var request = ViewBag.CurrentRequest as BaseFilterRequest;
    int count = (Model.PageNumber - 1) * Model.PageSize;
}

<div class="page-content-custom">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
        <div class="mb-2 mb-md-0">
            <h4 style="font-weight: 700; margin:0; color:#1b2559;">Yorum Listesi</h4>
            <p style="color: #a3aed0; font-size: 0.9rem; margin:0;">
                Bloglara yapılan yorumları yönetin.
            </p>
        </div>

        <div class="d-flex align-items-center">
            <partial name="Partials/_AdminSearch" model="request"></partial>
        </div>
    </div>

    <div class="table-card">
        <div class="table-responsive">
            <table class="table table-modern">
                <thead>
                    <tr>
                        <th style="width:50px;">#</th>
                        <th style="width:240px;">KULLANICI</th>
                        <th style="width:220px;">EMAIL</th>
                        <th>YORUM</th>
                        <th style="width:110px;">BLOG ID</th>
                        <th style="width:140px;">TARİH</th>
                        <th style="width:110px;" class="text-right">İŞLEM</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        count++;

                        <tr>
                            <td class="font-weight-bold text-muted">@count</td>

                            <td>
                                <span class="font-weight-bold">@item.Name</span>
                            </td>

                            <td>
                                <span class="text-muted">@item.Email</span>
                            </td>

                            <td>
                                <span class="text-truncate-custom"
                                      data-description="@item.Description"
                                      title="@item.Description"
                                      style="max-width: 600px; display: inline-block;">
                                    @item.Description
                                </span>
                            </td>

                            <td>
                                <span class="badge badge-light">@item.BlogId</span>
                            </td>

                            <td>
                                @(item.CreateDate.ToString("dd.MM.yyyy"))
                            </td>

                            <td class="text-right">
                                <a asp-area="Admin"
                                   asp-controller="AdminComment"
                                   asp-action="RemoveComment"
                                   asp-route-id="@item.CommentId"
                                   class="btn-icon-sm js-delete"
                                   data-title="Yorum Sil"
                                   data-message="Bu yorumu silmek istediğinize emin misiniz?">
                                    <i class="fas fa-trash fa-xs"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="Partials/_AdminPagination" model="Model"/>
        <partial name="Partials/_AdminDescriptionModal" />
    </div>
</div>