@model IPagedList<ResultTestimonialDto>

@{
    ViewData["Title"] = "Referans Listesi";
    var request = ViewBag.CurrentRequest as BaseFilterRequest;
    int count = (Model.PageNumber - 1) * Model.PageSize; 
}

<div class="page-content-custom">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
        <div class="mb-2 mb-md-0"> <h4 style="font-weight: 700; margin:0; color:#1b2559;">Referans Listesi</h4>
            <p style="color: #a3aed0; font-size: 0.9rem; margin:0;">Müşteri yorumlarını yönetin.</p>
        </div>

        <div class="d-flex align-items-center">
            <partial name="Partials/_AdminSearch" model="request" />
            <a asp-area="Admin" asp-controller="AdminTestimonial" asp-action="CreateTestimonial" 
               class="btn btn-primary btn-sm rounded-pill px-4 py-2" 
               style="background: #4318FF; border:none; font-weight:500;">
                <i class="fas fa-plus mr-1"></i> Yeni Ekle </a>
        </div>
    </div>

    <div class="table-card">
        <div class="table-responsive">
            <table class="table table-modern">
                <thead>
                    <tr>
                        <th style="width: 50px;">#</th>
                        <th style="width: 250px;">AD SOYAD</th>
                        <th style="width: 150px;">UNVAN</th>
                        <th>YORUM</th>
                        <th style="width: 100px;" class="text-right">İŞLEMLER</th> </tr>
                </thead>
                <tbody id="tableBody">
                    @foreach (var item in Model)
                    {
                        count++;
                        
                        <tr>
                            <td class="font-weight-bold text-muted">@count</td> 

                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="mr-3">
                                        <partial name="Partials/_AdminAvatar" 
                                                 model="@(new AdminAvatarViewModel { 
                                                     Name = item.Name, 
                                                     ImageUrl = item.ImageUrl, 
                                                     Index = count,
                                                     Size = 40 
                                                 })" />
                                    </div>
                                    
                                    <span class="font-weight-bold">@item.Name</span>
                                </div>
                            </td>
                
                            <td><span class="badge badge-light text-secondary border">@item.Title</span></td> <td>
                                <span class="text-truncate-custom" title="@item.Comment">
                                    @item.Comment
                                </span>
                            </td>
                            <td class="text-right"> <a asp-area="Admin" asp-controller="AdminTestimonial" asp-action="UpdateTestimonial" asp-route-id="@item.TestimonialId" 
                                   class="btn-icon-sm" title="Güncelle">
                                    <i class="fas fa-pen fa-xs"></i>
                                </a>
                                <a asp-area="Admin" asp-controller="AdminTestimonial" asp-action="RemoveTestimonial" asp-route-id="@item.TestimonialId" 
                                   class="btn-icon-sm js-delete"
                                   title="Sil" 
                                    data-title="Referans Sil"
                                    data-message="Bu referans kaydını silmek istediğinize emin misiniz?">
                                    <i class="fas fa-trash fa-xs"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="Partials/_AdminPagination" model="Model"></partial>
    </div>
</div>