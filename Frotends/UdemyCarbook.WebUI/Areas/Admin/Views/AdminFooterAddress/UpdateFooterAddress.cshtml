@model UpdateFooterAddressDto

@{
    ViewData["Title"] = "Alt Bilgi Adresi Güncelle";
}

<div class="page-content-custom">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
        <div>
            <h4 style="font-weight:700; margin:0; color:#1b2559;">Alt Bilgi Adresi Güncelle</h4>
            <p style="color:#a3aed0; font-size:0.9rem; margin:0;">
                Footer ve iletişim bölümünde görünen adres bilgilerini buradan güncelleyebilirsiniz.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="AdminFooterAddress"
           asp-action="Index"
           class="btn btn-light btn-sm rounded-pill px-4 py-2"
           style="border:1px solid #e6e8f0;">
            <i class="fas fa-arrow-left mr-1"></i> Listeye Dön
        </a>
    </div>

    <div class="table-card" style="padding:24px;">
        <form method="post">

            <input type="hidden" asp-for="FooterAddressId" />

            <div class="form-group mb-3">
                <label asp-for="Address" class="font-weight-bold" style="color:#1b2559;">Adres</label>
                <input asp-for="Address"
                       class="form-control"
                       placeholder="Adres bilgisini giriniz" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description" class="font-weight-bold" style="color:#1b2559;">Açıklama</label>
                <textarea asp-for="Description"
                          class="form-control"
                          rows="5"
                          placeholder="Açıklamayı giriniz"></textarea>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Phone" class="font-weight-bold" style="color:#1b2559;">Telefon</label>
                <input asp-for="Phone"
                       type="tel"
                       class="form-control"
                       placeholder="Telefon numarasını giriniz" />
            </div>

            <div class="form-group mb-4">
                <label asp-for="Mail" class="font-weight-bold" style="color:#1b2559;">Mail</label>
                <input asp-for="Mail"
                       type="email"
                       class="form-control"
                       placeholder="Mail adresini giriniz" />
            </div>

            <div class="d-flex gap-2">
                <button type="submit"
                        class="btn btn-warning rounded-pill px-4 py-2"
                        style="border:none;">
                    <i class="fas fa-pen mr-1"></i> Güncelle
                </button>

                <a asp-area="Admin"
                   asp-controller="AdminFooterAddress"
                   asp-action="Index"
                   class="btn btn-outline-secondary rounded-pill px-4 py-2">
                    Vazgeç
                </a>
            </div>
        </form>
    </div>
</div>