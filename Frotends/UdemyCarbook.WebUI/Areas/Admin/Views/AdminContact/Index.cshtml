@model IPagedList<ResultContactDto>

@{
    ViewData["Title"] = "Gelen Mesajlar";
    var request = ViewBag.CurrentRequest as BaseFilterRequest;
    int count = (Model.PageNumber - 1) * Model.PageSize;
}

<div class="page-content-custom">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
        <div>
            <h4 style="font-weight:700; margin:0; color:#1b2559;">Gelen Mesajlar</h4>
            <p style="color:#a3aed0; font-size:0.9rem; margin:0;">
                Ana sayfadaki iletişim formundan gelen mesajları yönetin.
            </p>
        </div>

        <partial name="Partials/_AdminSearch" model="request"></partial>
    </div>

    <div class="table-card">
        <div class="table-responsive">
            <table class="table table-modern">
                <thead>
                    <tr>
                        <th style="width:50px;">#</th>
                        <th style="width:220px;">GÖNDEREN</th>
                        <th style="width:260px;">KONU</th>
                        <th style="width:240px;">EMAIL</th>
                        <th style="width:130px;">TARİH</th>
                        <th>MESAJ</th>
                        <th style="width:100px;" class="text-right">İŞLEM</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        count++;

                        <tr>
                            <td class="text-muted font-weight-bold">@count</td>

                            <td class="font-weight-bold">@item.Name</td>

                            <td>
                                <span class="text-truncate-custom"
                                      title="@item.Subject"
                                      style="max-width: 240px; display:inline-block;">
                                    @item.Subject
                                </span>
                            </td>

                            <td class="text-muted">@item.Email</td>

                            <td>@item.SenDate.ToString("dd.MM.yyyy")</td>

                            <td>
                                <span class="text-truncate-custom"
                                      data-description="@item.Message"
                                      title="@item.Message"
                                      style="max-width: 300px; display:inline-block;">
                                    @item.Message
                                </span>
                            </td>

                            <td class="text-right">
                                <a asp-area="Admin"
                                   asp-controller="AdminContact"
                                   asp-action="RemoveContact"
                                   asp-route-id="@item.ContactId"
                                   class="btn-icon-sm js-delete"
                                   data-title="Mesaj Sil"
                                   data-message="Bu mesajı silmek istediğinize emin misiniz?">
                                    <i class="fas fa-trash fa-xs"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="Partials/_AdminPagination" model="Model"/>
        <partial name="Partials/_AdminDescriptionModal" />
    </div>
</div>
