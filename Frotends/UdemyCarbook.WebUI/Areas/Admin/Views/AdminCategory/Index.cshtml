@model IPagedList<ResultCategoryDto>

@{
    ViewData["Title"] = "Kategori Listesi";
    var request = ViewBag.CurrentRequest as BaseFilterRequest;
    int count = (Model.PageNumber - 1) * Model.PageSize;
}

<div class="page-content-custom">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
        <div class="mb-2 mb-md-0">
            <h4 style="font-weight:700; margin:0; color:#1b2559;">Kategori Listesi</h4>
            <p style="color:#a3aed0; font-size:0.9rem; margin:0;">
                Blog kategorilerini yönetin.
            </p>
        </div>

        <div class="d-flex align-items-center">
            <partial name="Partials/_AdminSearch" model="request"></partial>

            <a asp-area="Admin"
               asp-controller="AdminCategory"
               asp-action="CreateCategory"
               class="btn btn-primary btn-sm rounded-pill px-4 py-2"
               style="background:#4318FF; border:none; font-weight:500;">
                <i class="fas fa-plus mr-1"></i> Yeni Ekle
            </a>
        </div>
    </div>

    <div class="table-card">
        <div class="table-responsive">
            <table class="table table-modern">
                <thead>
                    <tr>
                        <th style="width:50px;">#</th>
                        <th style="width:420px;">KATEGORİ ADI</th>
                        <th style="width:140px;" class="text-right">İŞLEMLER</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        count++;

                        <tr>
                            <td class="font-weight-bold text-muted">@count</td>

                            <td>
                                <span class="font-weight-bold">@item.Name</span>
                            </td>

                            <td class="text-right">
                                <a asp-area="Admin"
                                   asp-controller="AdminCategory"
                                   asp-action="UpdateCategory"
                                   asp-route-id="@item.CategoryId"
                                   class="btn-icon-sm"
                                   title="Güncelle">
                                    <i class="fas fa-pen fa-xs"></i>
                                </a>

                                <a asp-area="Admin"
                                   asp-controller="AdminCategory"
                                   asp-action="RemoveCategory"
                                   asp-route-id="@item.CategoryId"
                                   class="btn-icon-sm js-delete"
                                   data-title="Kategori Sil"
                                   data-message="'@item.Name' kategorisini silmek istediğinize emin misiniz?"
                                   title="Sil">
                                    <i class="fas fa-trash fa-xs"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="Partials/_AdminPagination" model="Model"></partial>
    </div>
</div>