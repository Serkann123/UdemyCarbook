@model CreateAuthorDto

@{
    ViewData["Title"] = "Yazar Ekle";
}

<div class="page-content-custom">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
        <div>
            <h4 style="font-weight:700; margin:0; color:#1b2559;">Yazar Ekle</h4>
            <p style="color:#a3aed0; font-size:0.9rem; margin:0;">
                Yazar bilgilerini buradan ekleyin.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="AdminAuthor"
           asp-action="Index"
           class="btn btn-light btn-sm rounded-pill px-4 py-2"
           style="border:1px solid #e6e8f0;">
            <i class="fas fa-arrow-left mr-1"></i> Listeye Dön
        </a>
    </div>

    <div class="table-card" style="padding:24px;">
        <form method="post">

            <div class="form-group mb-3">
                <label asp-for="Name" class="font-weight-bold" style="color:#1b2559;">Ad Soyad</label>
                <input asp-for="Name"
                       class="form-control"
                       placeholder="Yazar adını giriniz" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description" class="font-weight-bold" style="color:#1b2559;">Açıklama</label>
                <textarea asp-for="Description"
                          class="form-control"
                          rows="6"
                          placeholder="Açıklamayı giriniz"></textarea>
            </div>

            <div class="form-group mb-4">
                <label asp-for="ImageUrl" class="font-weight-bold" style="color:#1b2559;">Yazar Görsel Linki</label>
                <input asp-for="ImageUrl"
                       class="form-control"
                       placeholder="Görsel linkini giriniz" />
                <small class="text-muted d-block mt-1">
                    Örn: https://.../author.jpg
                </small>
            </div>

            <div class="d-flex gap-2">
                <button type="submit"
                        class="btn btn-primary rounded-pill px-4 py-2"
                        style="background:#4318FF; border:none;">
                    <i class="fas fa-save mr-1"></i> Kaydet
                </button>

                <a asp-area="Admin"
                   asp-controller="AdminAuthor"
                   asp-action="Index"
                   class="btn btn-outline-secondary rounded-pill px-4 py-2">
                    Vazgeç
                </a>
            </div>

        </form>
    </div>

</div>