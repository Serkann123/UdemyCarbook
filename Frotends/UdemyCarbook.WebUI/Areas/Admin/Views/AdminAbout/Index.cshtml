@model List<ResultAboutDto>

@{
    ViewData["Title"] = "Hakkımda";
    int count = 0;
}

<div class="page-content-custom">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
        <div class="mb-2 mb-md-0">
            <h4 style="font-weight: 700; margin:0; color:#1b2559;">Hakkımızda</h4>
            <p style="color: #a3aed0; font-size: 0.9rem; margin:0;">
                Ana sayfa ve Hakkımızda sayfasında görünen bilgileri buradan yönetin. Tema bütünlüğü için 1 kayıt önerilir.
            </p>
        </div>

        <div class="d-flex align-items-center">
            <a asp-area="Admin"
               asp-controller="AdminAbout"
               asp-action="CreateAbout"
               class="btn btn-primary btn-sm rounded-pill px-4 py-2"
               style="background: #4318FF; border:none; font-weight:500;">
                <i class="fas fa-plus mr-1"></i> Yeni Ekle
            </a>
        </div>
    </div>

    <div class="table-card">
        <div class="table-responsive">
            <table class="table table-modern">
                <thead>
                    <tr>
                        <th style="width:50px;">#</th>
                        <th style="width:240px;">BAŞLIK</th>
                        <th>AÇIKLAMA</th>
                        <th style="width:170px;">GÖRSEL</th>
                        <th style="width:120px;" class="text-right">İŞLEMLER</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        count++;

                        <tr>
                            <td class="font-weight-bold text-muted">@count</td>

                            <td>
                                <span class="font-weight-bold">@item.Title</span>
                            </td>

                            <td style="white-space: normal; color:#707eae; line-height:1.5;">
                                @item.Description
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl"
                                         alt="About Image"
                                         style="width:140px; height:130px; object-fit:cover; border-radius:14px; border:1px solid #f0f2f5; box-shadow:0 6px 18px rgba(0,0,0,0.06);" />
                                }
                                else
                                {
                                    <span class="badge badge-light text-secondary border">Görsel yok</span>
                                }
                            </td>

                            <td class="text-right">
                                <a asp-area="Admin"
                                   asp-controller="AdminAbout"
                                   asp-action="UpdateAbout"
                                   asp-route-id="@item.AboutId"
                                   class="btn-icon-sm"
                                   title="Güncelle">
                                    <i class="fas fa-pen fa-xs"></i>
                                </a>

                                <a asp-area="Admin"
                                   asp-controller="AdminAbout"
                                   asp-action="RemoveAbout"
                                   asp-route-id="@item.AboutId"
                                   class="btn-icon-sm js-delete"
                                   title="Sil"
                                   data-title="About Sil"
                                   data-message="Bu About kaydını silmek istediğinize emin misiniz?">
                                    <i class="fas fa-trash fa-xs"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
