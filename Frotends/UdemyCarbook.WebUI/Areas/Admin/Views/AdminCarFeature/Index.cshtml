@model List<ResultCarFeatureByCarIdResultDto>

@{
    ViewData["Title"] = "Araba Özellik Düzenleme";
}

<div class="page-content-custom">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
        <div class="mb-2 mb-md-0">
            <h4 style="font-weight: 700; margin:0; color:#1b2559;">Araba Özelliklerini Düzenle</h4>
            <p style="color: #a3aed0; font-size: 0.9rem; margin:0;">
                Bu araca ait donanımları aktif veya pasif hale getirin.
            </p>
        </div>
    </div>

    <div class="card shadow-none border-0" style="background: transparent;">
        <form method="post">
            <div class="row">
                @for (int i = 0; i < Model.Count; i++)
                {
                    <div class="col-md-3 mb-3">
                        <div class="p-3 bg-white rounded-lg shadow-sm d-flex align-items-center" style="border: 1px solid #e0e5f2; border-radius: 12px;">

                            <input type="hidden" asp-for="@Model[i].CarFeatureId" />
                            <input type="hidden" asp-for="@Model[i].FeatureName" />

                            <div class="form-check form-switch m-0 d-flex align-items-center">
                                <input type="checkbox" asp-for="@Model[i].Available"
                                       class="form-check-input"
                                       id="check_@i"
                                       style="cursor: pointer; width: 2.2em; height: 1.1em;">

                                <label class="form-check-label font-weight-bold ml-2" for="check_@i" style="color: #1b2559; cursor: pointer;">
                                    @Model[i].FeatureName
                                </label>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="d-flex align-items-center mt-4">
                <button type="submit"
                        class="btn btn-primary rounded-pill px-5 py-2"
                        style="background:#4318FF; border:none; font-weight:600; box-shadow: 0px 4px 12px rgba(67, 24, 255, 0.25);">
                    <i class="fas fa-save mr-2"></i> Değişiklikleri Kaydet
                </button>

                <a href="/Admin/AdminCar/Index"
                   class="btn btn-link text-muted ml-3"
                   style="font-weight: 600; text-decoration: none;">
                    Vazgeç
                </a>
            </div>
        </form>
    </div>
</div>